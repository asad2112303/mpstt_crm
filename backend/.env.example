# MPSTT CRM backend — environment variable NAMES only. Never commit real values.
APP_ENV=development
DEBUG=false

# Async database URL (local dev uses the docker-compose Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/mpstt_crm

# Comma-separated allowlist
CORS_ORIGINS=http://localhost:3000
# Optional regex for deploy previews whose hostname changes per build,
# e.g. https://myapp-.*\.vercel\.app  (leave blank to disable)
CORS_ORIGIN_REGEX=

# Supabase project (required in staging/production)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUD=authenticated

# supabase | local
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/storage

# Must be true in production
REQUIRE_ADMIN_MFA=false
