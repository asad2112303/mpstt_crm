# MPSTT CRM production environment — NAMES ONLY. Copy to infra/.env.prod and
# fill real values. NEVER commit .env.prod (it is gitignored).

# --- Database (managed Supabase Postgres, least-privileged crm_app role) ---
# Long-lived container -> direct/session pooling (port 5432).
DATABASE_URL=postgresql+asyncpg://crm_app:CHANGE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Supabase project ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy JWT secret (Settings -> API). Optional if tokens are ES256 (JWKS is used).
SUPABASE_JWT_SECRET=
# Secret key (sb_secret_...). Server-side ONLY: storage + admin invites.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_... or legacy anon) — safe for the browser.
SUPABASE_PUBLISHABLE_KEY=

# --- URLs ---
# The public HTTPS origin users open, e.g. https://crm.mpstt.com
CORS_ORIGINS=https://crm.mpstt.com
# Optional: allow deploy previews (Vercel branch URLs change per build).
CORS_ORIGIN_REGEX=
# Where the BROWSER reaches the API, e.g. https://api.crm.mpstt.com
PUBLIC_API_BASE_URL=https://api.crm.mpstt.com

# --- Host port bindings (behind your TLS proxy) ---
API_PORT=8000
WEB_PORT=3000
